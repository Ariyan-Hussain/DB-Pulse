DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password

# Optional DB-Pulse alert thresholds (defaults shown)
DB_PULSE_ALERT_CONNECTION_WARNING_PERCENT=75
DB_PULSE_ALERT_CONNECTION_CRITICAL_PERCENT=90
DB_PULSE_ALERT_NEAR_MAX_WARNING_REMAINING=10
DB_PULSE_ALERT_NEAR_MAX_CRITICAL_REMAINING=2
DB_PULSE_ALERT_QUERY_RATE_WARNING_PER_MINUTE=600

# Optional SQLAlchemy application-pool alert thresholds (percent, 1-100)
DB_PULSE_POOL_WARNING_PERCENT=75
DB_PULSE_POOL_CRITICAL_PERCENT=90

# Optional backup preflight only; this feature never restores a dump
DB_PULSE_BACKUP_DIR=
DB_PULSE_BACKUP_MAX_BYTES=104857600
DB_PULSE_BACKUP_TIMEOUT_SECONDS=60
